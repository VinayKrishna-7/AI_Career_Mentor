PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
# Local example: postgresql://postgres:postgres@localhost:5432/career_mentor
# Cloud example (Neon / Supabase): postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_mentor

# JWT Secret for authentication tokens (minimum 32 chars)
JWT_SECRET=super_secret_career_mentor_jwt_key_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Cookie Secret
COOKIE_SECRET=super_secret_cookie_signing_key_at_least_32_chars

# AI Provider Configuration: 'gemini' or 'openai'
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
